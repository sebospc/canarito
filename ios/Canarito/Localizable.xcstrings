    "En el computador del servidor ejecuta `canarito.py pair` y escanea el QR que aparece.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el computador del servidor ejecuta `canarito.py pair` y escanea el QR que aparece."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the server's computer run `canarito.py pair` and scan the QR it shows."
          }
