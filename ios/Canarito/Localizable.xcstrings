    "Si desvinculas ahora, el servidor seguirá creyendo que este iPhone existe hasta que su administrador lo quite.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si desvinculas ahora, el servidor seguirá creyendo que este iPhone existe hasta que su administrador lo quite."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you unlink now, the server will keep thinking this iPhone exists until its administrator removes it."
          }
        }
      }
    },
