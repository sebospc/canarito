    "Sin ubicación «Siempre», tu servidor sigue la zona donde abriste la app por última vez. Si cambias de ciudad, podrías no recibir los avisos de tu zona.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin ubicación «Siempre», tu servidor sigue la zona donde abriste la app por última vez. Si cambias de ciudad, podrías no recibir los avisos de tu zona."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without location “Always”, your server follows the area where you last opened the app. If you change city, you may miss the alerts for your area."
          }
        }
      }
    },
    "Solo hablas con el servidor al que te vincules. Sin registro, sin correo, sin anuncios.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo hablas con el servidor al que te vincules. Sin registro, sin correo, sin anuncios."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You only talk to the server you link to. No sign-up, no email, no ads."
          }
        }
      }
    },
