    "El código está incompleto. Genera otro en el servidor.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El código está incompleto. Genera otro en el servidor."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The code is incomplete. Make another one on the server."
          }
        }
      }
    },
    "El código ya se usó o venció. Genera otro con `canarito.py pair`.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El código ya se usó o venció. Genera otro con `canarito.py pair`."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The code was already used or expired. Make another with `canarito.py pair`."
          }
        }
      }
    },
    "El receptor que te cubre está apagado. Avisa a quien administra el servidor.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El receptor que te cubre está apagado. Avisa a quien administra el servidor."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The receptor that covers you is off. Tell whoever runs the server."
          }
        }
      }
    },
    "El responsable de lo que guarda el servidor es quien lo administra.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El responsable de lo que guarda el servidor es quien lo administra."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whoever runs the server is responsible for what it stores."
