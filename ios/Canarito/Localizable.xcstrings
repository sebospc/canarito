    "Con un modo de Concentración activo, el aviso puede llegar en silencio.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con un modo de Concentración activo, el aviso puede llegar en silencio."
