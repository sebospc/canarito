{
  "sourceLanguage": "es",
  "strings": {
    "A tu servidor: tu posición redondeada a 1 km, cuando te mueves, y un identificador de tu iPhone que solo el relé de Canarito puede abrir para enviarte el aviso.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A tu servidor: tu posición redondeada a 1 km, cuando te mueves, y un identificador de tu iPhone que solo el relé de Canarito puede abrir para enviarte el aviso."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To your server: your position rounded to 1 km, when you move, and an identifier of your iPhone that only the Canarito relay can open to send you the alert."
          }
        }
      }
    },
    "Abre Canarito para ver qué pasa con tu servidor.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Canarito para ver qué pasa con tu servidor."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Canarito to see what is going on with your server."
          }
        }
      }
    },
    "Abre los ajustes del servidor": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre los ajustes del servidor"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens the server settings"
          }
        }
      }
    },
    "Abrir Ajustes": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir Ajustes"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Settings"
          }
        }
      }
    },
    "Ajustes": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustes"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings"
          }
        }
      }
    },
    "Al relé: el aviso pasa por él hacia Apple. No guarda nada.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al relé: el aviso pasa por él hacia Apple. No guarda nada."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To the relay: the alert goes through it to Apple. It stores nothing."
          }
        }
      }
    },
    "Así sonará un aviso de sismo. Esto es solo una prueba.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Así sonará un aviso de sismo. Esto es solo una prueba."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is how an earthquake alert will sound. This is only a test."
          }
        }
      }
    },
