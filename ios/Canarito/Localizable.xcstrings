    "Hace 8 días que Canarito no habla con tu servidor. Abre la app para comprobar que sigues cubierto.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hace 8 días que Canarito no habla con tu servidor. Abre la app para comprobar que sigues cubierto."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Canarito has not talked to your server for 8 days. Open the app to check that you are still covered."
          }
        }
      }
    },
    "Le enviará tu posición redondeada a 1 km cada vez que te muevas. Si no lo reconoces, cancela.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Le enviará tu posición redondeada a 1 km cada vez que te muevas. Si no lo reconoces, cancela."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It will get your position rounded to 1 km each time you move. If you do not recognize it, cancel."
          }
        }
      }
    },
