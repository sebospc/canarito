    "Para que el receptor esté donde estás, Canarito envía a tu servidor tu posición redondeada a 1 km, solo cuando te mueves. Tu posición exacta no sale del iPhone.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para que el receptor esté donde estás, Canarito envía a tu servidor tu posición redondeada a 1 km, solo cuando te mueves. Tu posición exacta no sale del iPhone."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "So the receptor is where you are, Canarito sends your server your position rounded to 1 km, only when you move. Your exact position does not leave the iPhone."
          }
        }
      }
    },
