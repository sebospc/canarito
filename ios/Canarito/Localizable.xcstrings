    "Avisos desactivados": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Avisos desactivados"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alerts are off"
          }
        }
      }
    },
    "Canarito no es un sistema oficial y puede fallar o llegar tarde. Si sientes un sismo, protégete aunque no suene nada.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Canarito no es un sistema oficial y puede fallar o llegar tarde. Si sientes un sismo, protégete aunque no suene nada."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Canarito is not an official system and can fail or arrive late. If you feel an earthquake, protect yourself even if nothing sounds."
          }
        }
      }
    },
    "Canarito no tiene permiso para usar la cámara. Actívalo en Ajustes o pega el enlace.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Canarito no tiene permiso para usar la cámara. Actívalo en Ajustes o pega el enlace."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Canarito has no permission to use the camera. Turn it on in Settings or paste the link."
          }
        }
      }
    },
