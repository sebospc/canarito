    "Revisa tu conexión y que el servidor esté encendido. Mientras tanto no sabemos si te llegarán avisos.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa tu conexión y que el servidor esté encendido. Mientras tanto no sabemos si te llegarán avisos."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check your connection and that the server is on. Meanwhile we do not know if alerts will reach you."
          }
        }
