            "value": "That link is not from Canarito."
          }
        }
      }
    },
    "Ese servidor no usa una conexión segura (https). No lo vinculamos.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese servidor no usa una conexión segura (https). No lo vinculamos."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That server does not use a secure connection (https). We will not link it."
          }
        }
      }
    },
    "Espera 10 minutos antes de pedir otra prueba.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Espera 10 minutos antes de pedir otra prueba."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wait 10 minutes before asking for another test."
          }
        }
      }
    },
    "Esta app no es un sistema oficial. Puede fallar o llegar tarde, y no reemplaza las indicaciones de las autoridades.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta app no es un sistema oficial. Puede fallar o llegar tarde, y no reemplaza las indicaciones de las autoridades."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app is not an official system. It can fail or arrive late, and it does not replace the instructions of the authorities."
          }
        }
      }
    },
