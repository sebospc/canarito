    "Avisos de sismo de tu servidor, en tu iPhone.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Avisos de sismo de tu servidor, en tu iPhone."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Earthquake alerts from your server, on your iPhone."
