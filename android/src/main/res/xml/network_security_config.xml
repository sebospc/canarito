<?xml version="1.0" encoding="utf-8"?>
<!-- targetSdk 35 blocks cleartext by default. A local ntfy or monitor is reached over plain HTTP only
     at 10.0.2.2, the host's loopback as seen from the emulator; everything else stays HTTPS. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
